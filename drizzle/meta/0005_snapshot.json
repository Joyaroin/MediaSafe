  "views": {
    "public.library_entry_progress": {
      "columns": {
        "library_entry_id": {
          "name": "library_entry_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "user_id": {
          "name": "user_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "title_id": {
          "name": "title_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "episode_id": {
          "name": "episode_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "season_no": {
          "name": "season_no",
          "type": "smallint",
          "primaryKey": false,
          "notNull": true
        },
        "episode_no": {
          "name": "episode_no",
          "type": "smallint",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  select distinct on (le.id)\n    le.id as library_entry_id,\n    le.user_id as user_id,\n    le.title_id as title_id,\n    e.id as episode_id,\n    e.season_no as season_no,\n    e.episode_no as episode_no\n  from library_entry le\n  join watch w on w.library_entry_id = le.id\n  join episode e on e.id = w.episode_id\n  where e.season_no > 0\n  order by le.id, e.season_no desc, e.episode_no desc\n",
      "name": "library_entry_progress",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.library_entry_remaining": {
      "columns": {
        "library_entry_id": {
          "name": "library_entry_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "user_id": {
          "name": "user_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "title_id": {
          "name": "title_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "remaining": {
          "name": "remaining",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  select\n    le.id as library_entry_id,\n    le.user_id as user_id,\n    le.title_id as title_id,\n    (\n      select count(*)::int\n      from episode e\n      where e.title_id = le.title_id\n        and e.season_no > 0\n        and not exists (\n          select 1 from watch w\n          where w.library_entry_id = le.id and w.episode_id = e.id\n        )\n    ) as remaining\n  from library_entry le\n  join title t on t.id = le.title_id\n  where t.kind = 'show'\n",
      "name": "library_entry_remaining",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.library_entry_state": {
      "columns": {
        "library_entry_id": {
          "name": "library_entry_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "user_id": {
          "name": "user_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "title_id": {
          "name": "title_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "state": {
          "name": "state",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  select\n    le.id as library_entry_id,\n    le.user_id as user_id,\n    le.title_id as title_id,\n    case\n      when le.abandoned_at is not null then 'abandoned'\n      when not exists (\n        select 1 from watch w where w.library_entry_id = le.id\n      ) then 'watchlist'\n      when t.kind = 'film' then 'finished'\n      when t.in_production = false and not exists (\n        select 1\n        from episode e\n        where e.title_id = le.title_id\n          and e.season_no > 0\n          and not exists (\n            select 1 from watch w\n            where w.library_entry_id = le.id and w.episode_id = e.id\n          )\n      ) then 'finished'\n      when not exists (\n        select 1\n        from episode e\n        where e.title_id = le.title_id\n          and e.season_no > 0\n          and e.air_date is not null\n          and e.air_date <= current_date\n          and not exists (\n            select 1 from watch w\n            where w.library_entry_id = le.id and w.episode_id = e.id\n          )\n      ) then 'caught_up'\n      else 'watching'\n    end as state\n  from library_entry le\n  join title t on t.id = le.title_id\n",
      "name": "library_entry_state",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    },
    "public.library_entry_up_next": {
      "columns": {
        "library_entry_id": {
          "name": "library_entry_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "user_id": {
          "name": "user_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "title_id": {
          "name": "title_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "episode_id": {
          "name": "episode_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "season_no": {
          "name": "season_no",
          "type": "smallint",
          "primaryKey": false,
          "notNull": true
        },
        "episode_no": {
          "name": "episode_no",
          "type": "smallint",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  select\n    p.library_entry_id as library_entry_id,\n    p.user_id as user_id,\n    p.title_id as title_id,\n    n.id as episode_id,\n    n.season_no as season_no,\n    n.episode_no as episode_no\n  from library_entry_progress p\n  join lateral (\n    select e.id, e.season_no, e.episode_no\n    from episode e\n    where e.title_id = p.title_id\n      and e.season_no > 0\n      and (e.season_no, e.episode_no) > (p.season_no, p.episode_no)\n    order by e.season_no, e.episode_no\n    limit 1\n  ) n on true\n",
      "name": "library_entry_up_next",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
