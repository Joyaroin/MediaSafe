{
  "name": "mediasafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build.ts",
    "start": "next start",
    "lint": "eslint",
    "lint:sql": "squawk --config=.squawk.toml --no-error-on-unmatched-pattern 'drizzle/*.sql'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:routes": "vitest run tests/route-manifest.test.ts",
    "test:fixtures": "vitest run tests/fixture-archive.test.ts",
    "test:conversion": "vitest run tests/tvtracker-conversion.test.ts",
    "convert:tvtracker": "tsx --env-file-if-exists=.env scripts/convert-tvtracker/cli.ts",
    "db:up": "docker compose up -d --wait && npm run db:migrate",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && npm run db:up",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts",
    "db:psql": "docker compose exec postgres psql -U mediasafe -d mediasafe",
    "auth:generate": "auth generate --config auth.config.ts --output auth-schema.ts --adapter drizzle --dialect postgresql --yes"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.70.0",
    "better-auth": "^1.6.30",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "auth": "^1.6.30",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "squawk-cli": "2.62.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
