# MediaSafe — environment variables.
# Copy to .env and fill in, or run scripts/provision.sh, which writes it for you.
# Never commit .env.

# Local development runs against Docker Postgres, not Neon. `npm run db:up` brings
# up both containers; `docker-compose.yml` explains why there are two.
DATABASE_URL=postgres://mediasafe:mediasafe@localhost:5432/mediasafe

# The local WebSocket proxy that fronts Docker Postgres, so the one driver
# (neon-serverless over a WebSocket Pool) works locally too. LEAVE THIS UNSET in
# Vercel: Neon speaks WebSocket itself, and setting it there would route production
# through a proxy that does not exist.
DATABASE_WS_PROXY=localhost:5433

# The shared Next.js cache (cache-handler.mjs). `npm run db:up` starts it with the
# database. Unset, nothing is cached: slower, never wrong. Not used on Vercel.
VALKEY_URL=redis://localhost:6379

# Better Auth. Google is the only sign-in method.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry. The event id is the reference id a user reads back to you.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Read by the Sentry server SDK itself. Set per cluster namespace (staging, production);
# leave unset locally.
SENTRY_ENVIRONMENT=

# TMDB, the single metadata source. A bearer token, sent as an Authorization
# header, valid across TMDB's v3 and v4 APIs. Server-side only — never
# NEXT_PUBLIC_, or it would be bundled and served to every visitor.
TMDB_READ_ACCESS_TOKEN=

# The nightly sweep's bearer token (app/api/cron/nightly-sweep/authorize.ts). Unset,
# the route rejects every request. Vercel sets it for its own cron; the cluster's
# CronJob reads it from Vault.
CRON_SECRET=

# Neon. Not used by the app locally — the app reads DATABASE_URL. These two are
# recorded here so provisioning has one home, and are copied into Vercel:
#   NEON_PRODUCTION_URL -> Vercel Production scope, as DATABASE_URL
#   NEON_PREVIEW_URL    -> Vercel Preview scope, as DATABASE_URL (schema-only)
# Both must be the POOLED connection string — the host with '-pooler' in it.
NEON_PRODUCTION_URL=
NEON_PREVIEW_URL=

# The domain Vercel assigns. Google's redirect URIs are built from it.
VERCEL_PRODUCTION_URL=
