#!/usr/bin/env bash
# terraform, with the tokens this stack needs loaded from Bitwarden for this one command.
#
#   export BW_SESSION="$(bw unlock --raw)"
#   ./tf init        # init with backend.hcl
#   ./tf plan
#   ./tf apply
#
# Nothing is written to disk: the tokens live in this process's environment and die with it.
# Your current public IP becomes the only address allowed to SSH and kubectl in, so a plan
# after your IP changes shows the firewall rule moving — that is expected.
set -euo pipefail
cd "$(dirname "$0")"

command -v bw >/dev/null || { echo "Install the Bitwarden CLI: brew install bitwarden-cli" >&2; exit 1; }
: "${BW_SESSION:?Unlock Bitwarden first: export BW_SESSION=\"\$(bw unlock --raw)\"}"

# Bitwarden login items, named exactly like this. See README.md for the scope of each.
secret() { bw get "$1" "$2" --session "$BW_SESSION"; }
LINODE_TOKEN="$(secret password mediasafe/linode-token)"
CLOUDFLARE_API_TOKEN="$(secret password mediasafe/cloudflare-token)"
AWS_ACCESS_KEY_ID="$(secret username mediasafe/r2-terraform-state)"
AWS_SECRET_ACCESS_KEY="$(secret password mediasafe/r2-terraform-state)"
export LINODE_TOKEN CLOUDFLARE_API_TOKEN AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY

ip="$(curl -fsS https://api.ipify.org)"
export TF_VAR_admin_cidrs="[\"$ip/32\"]"

if [[ "${1:-}" == "init" ]]; then
  shift
  exec terraform init -backend-config=backend.hcl "$@"
fi
exec terraform "$@"
