#!/usr/bin/env bash
# Copies the cluster's admin kubeconfig to ~/.kube/mediasafe.yaml, pointed at the VM.
#
#   ./fetch-kubeconfig
#   export KUBECONFIG=~/.kube/mediasafe.yaml
#
# Fetched over SSH rather than kept in Terraform state, so the state never holds cluster-admin
# credentials. The file is the keys to the whole cluster: it stays on this laptop.
set -euo pipefail
cd "$(dirname "$0")"

ip="$(./tf output -raw ip_address)"
dest="${KUBECONFIG_OUT:-$HOME/.kube/mediasafe.yaml}"

mkdir -p "$(dirname "$dest")"
umask 077
ssh -o StrictHostKeyChecking=accept-new "root@$ip" cat /etc/rancher/k3s/k3s.yaml \
  | sed "s#https://127.0.0.1:6443#https://$ip:6443#" > "$dest"

echo "Wrote $dest. Use it with: export KUBECONFIG=$dest"
