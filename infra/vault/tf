#!/usr/bin/env bash
# terraform for Vault's configuration, with a port-forward to Vault and the credentials it needs.
#
#   export BW_SESSION="$(bw unlock --raw)"
#   export KUBECONFIG=~/.kube/mediasafe.yaml
#   ./tf init
#   ./tf --root apply    # the first apply only: the root token is the only identity Vault has
#   vault login -method=oidc        # then, and from now on:
#   ./tf plan
#
# Without --root it uses the token `vault login -method=oidc` saved in ~/.vault-token, i.e. your
# Google login. --root reads the initial root token from Bitwarden and refuses once it is gone.
set -euo pipefail
cd "$(dirname "$0")"

use_root=false
if [[ "${1:-}" == "--root" ]]; then use_root=true; shift; fi

command -v bw >/dev/null || { echo "Install the Bitwarden CLI: brew install bitwarden-cli" >&2; exit 1; }
unlock_hint='Unlock Bitwarden first: export BW_SESSION="$(bw unlock --raw)"'
: "${BW_SESSION:?$unlock_hint}"
bw unlock --check --session "$BW_SESSION" >/dev/null 2>&1 \
  || { echo "BW_SESSION is stale. $unlock_hint" >&2; exit 1; }

# The CLI reads a local copy of the vault: without a sync, an item added in the app is "Not found."
bw sync --session "$BW_SESSION" >/dev/null
secret() { # field item
  bw get "$1" "$2" --session "$BW_SESSION" 2>/dev/null || {
    echo "Bitwarden has no login item named exactly '$2' with a $1 set. Names must match character for character." >&2
    exit 1
  }
}
AWS_ACCESS_KEY_ID="$(secret username mediasafe/r2-terraform-state)"
AWS_SECRET_ACCESS_KEY="$(secret password mediasafe/r2-terraform-state)"
TF_VAR_google_admin_client_id="$(secret username mediasafe/google-admin-oauth)"
TF_VAR_google_admin_client_secret="$(secret password mediasafe/google-admin-oauth)"
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY TF_VAR_google_admin_client_id TF_VAR_google_admin_client_secret

if [[ "${1:-}" == "init" ]]; then
  shift
  exec terraform init -backend-config=backend.hcl "$@"
fi

if $use_root; then
  VAULT_TOKEN="$(secret password mediasafe/vault-root-token)" \
    || { echo "No mediasafe/vault-root-token in Bitwarden: it has been revoked. Use vault login -method=oidc." >&2; exit 1; }
else
  [[ -s "$HOME/.vault-token" ]] \
    || { echo "No Vault login. Run: vault login -method=oidc  (or ./tf --root for the first apply)" >&2; exit 1; }
  VAULT_TOKEN="$(cat "$HOME/.vault-token")"
fi
export VAULT_TOKEN

# Reuse a port-forward that is already open (e.g. for `vault login`), otherwise open one for the
# length of this command.
if ! curl -fsS -o /dev/null http://127.0.0.1:8200/v1/sys/health 2>/dev/null; then
  kubectl -n vault port-forward svc/vault 8200:8200 >/dev/null 2>&1 &
  forward=$!
  trap 'kill "$forward" 2>/dev/null' EXIT
  for _ in $(seq 1 20); do
    curl -fsS -o /dev/null http://127.0.0.1:8200/v1/sys/health 2>/dev/null && break
    sleep 0.5
  done
fi
curl -fsS -o /dev/null http://127.0.0.1:8200/v1/sys/health \
  || { echo "Vault is not answering (sealed? run bootstrap/vault-unseal in mediasafe-gitops)." >&2; exit 1; }

terraform "$@"
