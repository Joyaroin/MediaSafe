# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage

# Playwright (issue #304). The fixture session it mints per run — a throwaway secret
# signs it and it names no real account — and the run's own report/trace output.
/tests/e2e/.auth/
/playwright-report/
/test-results/

# misc
.DS_Store
*.pem
.playwright-mcp/
.claude/

# The impeccable hook's own scratch state — session ids, per-file edit counts, and
# absolute paths into whichever worktree wrote them. It is machine-written on every
# edit, it is one single line, and it was tracked: two branches that both touched a
# file both rewrote that one line, so git had nothing to merge line-wise and every
# parallel branch conflicted on it. Twelve commits on main carry a change to it and
# nothing has ever read one. `.impeccable/config.json` and `design.json` are real
# project artefacts and stay tracked — only the cache goes.
.impeccable/hook.cache.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets. scripts/provision.sh writes .env at the repo root, and writes
# .env.example beside it — that one is meant to be committed.
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# Every other .env variant too; the example is the one meant to be committed (see above).
.env*
!.env.example

# terraform — providers and plans are local; the lock file is committed.
.terraform/
*.tfplan
*.tfstate
*.tfstate.*
